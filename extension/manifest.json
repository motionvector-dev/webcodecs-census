{
  "manifest_version": 3,
  "name": "WebCodecs Census",
  "version": "0.1.0",
  "description": "Find leaked VideoFrames, AudioData and codecs — including inside Web Workers — with the allocation stack that caused them.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "scripting",
    "storage",
    "debugger"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "WebCodecs Census"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/shim.global.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/shim.global.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
