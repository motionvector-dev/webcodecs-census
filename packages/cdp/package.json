{
  "name": "@motionvector/webcodecs-census-cdp",
  "version": "0.1.0",
  "description": "Inject the WebCodecs census into a running Chrome — page, iframes and Web Workers — over the DevTools Protocol.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist/index.js && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@motionvector/webcodecs-census": "0.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unfoundbox/webcodecs-census.git",
    "directory": "packages/cdp"
  }
}
